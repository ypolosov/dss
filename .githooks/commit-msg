#!/bin/bash
# Auto-bump version based on conventional commit prefix.
# Enable: git config core.hooksPath .githooks

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(head -1 "$COMMIT_MSG_FILE")
VERSION_FILE="packages/dss-api/package.json"

# Skip version bump commits, merges, and CI
case "$COMMIT_MSG" in
  "chore(release):"*|"Merge"*) exit 0 ;;
esac

# Determine bump type from conventional commit prefix
case "$COMMIT_MSG" in
  *"!"*":"*) BUMP="major" ;;
  "feat"*)   BUMP="minor" ;;
  *)         BUMP="patch" ;;
esac

# Extract current version
CURRENT=$(grep -o '"version": "[^"]*"' "$VERSION_FILE" | head -1 | grep -o '[0-9]\+\.[0-9]\+\.[0-9]\+')
if [ -z "$CURRENT" ]; then
  echo "commit-msg hook: could not read version from $VERSION_FILE"
  exit 0
fi

IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT"
case "$BUMP" in
  major) NEW="$((MAJOR+1)).0.0" ;;
  minor) NEW="$MAJOR.$((MINOR+1)).0" ;;
  patch) NEW="$MAJOR.$MINOR.$((PATCH+1))" ;;
esac

sed -i "0,/\"version\": \"$CURRENT\"/s//\"version\": \"$NEW\"/" "$VERSION_FILE"
git add "$VERSION_FILE"
git commit --amend --no-edit --no-verify >/dev/null 2>&1

echo "Version bumped: $CURRENT → $NEW ($BUMP)"
