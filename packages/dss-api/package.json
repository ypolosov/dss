{
  "name": "@dss/api",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "node --env-file=.env dist/main.js",
    "start:dev": "nest start --watch --exec \"node --env-file=.env\"",
    "start:debug": "nest start --debug --watch --exec \"node --env-file=.env\"",
    "start:prod": "node --env-file=.env dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/openai": "^3.0.41",
    "@mastra/core": "^1.10.0",
    "@mastra/libsql": "^1.6.0",
    "@mastra/memory": "^1.6.0",
    "@mastra/rag": "^2.1.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "ai": "^6.0.116",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.16",
    "@swc/core": "^1.15.18",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.0.0"
  }
}
