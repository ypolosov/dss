ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
DSS_MODEL=openai/gpt-4.1-mini
DSS_LLM_MAX_RETRIES=3
PORT=3000

# Vector Store
VECTOR_STORE_TYPE=libsql
VECTOR_DB_URL=file:../../vectors.db
VECTOR_INDEX_NAME=dss_knowledge
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Ingestion
INGESTION_DOCS_PATH=../../docs
INGESTION_API_KEY=
